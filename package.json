{
  "name": "bangtao-village-booking",
  "productName": "Bangtao Village Booking",
  "version": "1.3.9",
  "description": "ระบบจองห้องพัก Bangtao Village Resort",
  "author": "Bangtao Village Resort",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.bangtaovillage.booking",
    "productName": "Bangtao Village Booking",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bangtao Booking",
      "artifactName": "BangtaoBooking-Setup-${version}.exe",
      "installerLanguages": [
        "th_TH",
        "en_US"
      ],
      "language": "1054",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yeemaff",
        "repo": "bangtao-booking",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "BangtaoBooking-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "BangtaoBooking-mac-${arch}-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/bai-jamjuree": "^5.0.13",
    "@fontsource/ibm-plex-mono": "^5.0.13",
    "@fontsource/ibm-plex-sans-thai": "^5.0.13",
    "@supabase/supabase-js": "^2.45.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}